{
	"name": "df_inventario_diario",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "inventario_diario_csv",
						"type": "DatasetReference"
					},
					"name": "inventarioDiario"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "inventario_diario_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "mapeo"
				}
			],
			"scriptLines": [
				"source(output(",
				"          inventario_id as string,",
				"          fecha_inventario as string,",
				"          sucursal_id as string,",
				"          producto_id as string,",
				"          stock_inicial as string,",
				"          entradas as string,",
				"          salidas as string,",
				"          stock_final as string,",
				"          punto_reorden as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> inventarioDiario",
				"inventarioDiario derive(fecha_inventario = trim(fecha_inventario),",
				"          stock_inicial = trim(stock_inicial),",
				"          stock_final = trim(stock_final),",
				"          entradas = trim(entradas),",
				"          salidas = trim(salidas),",
				"          punto_reorden = trim(punto_reorden)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(inventario_id) && !isNull(fecha_inventario) && !isNull(sucursal_id) && !isNull(producto_id) && !isNull(stock_inicial) && !isNull(entradas) && !isNull(salidas) && !isNull(stock_final) && !isNull(punto_reorden),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(fecha_inventario = toDate(fecha_inventario),",
				"          stock_inicial = toInteger(stock_inicial),",
				"          stock_final = toInteger(stock_final),",
				"          entradas = toInteger(entradas),",
				"          salidas = toInteger(salidas),",
				"          punto_reorden = toInteger(punto_reorden)) ~> derivedColumn2",
				"derivedColumn2 derive(fecha = fecha_inventario,",
				"          stock_minimo = punto_reorden) ~> mapeo",
				"mapeo sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          inventario_id as string,",
				"          fecha as date,",
				"          sucursal_id as string,",
				"          producto_id as string,",
				"          stock_inicial as integer,",
				"          entradas as integer,",
				"          salidas as integer,",
				"          stock_final as integer,",
				"          stock_minimo as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          inventario_id,",
				"          fecha,",
				"          sucursal_id,",
				"          producto_id,",
				"          stock_inicial,",
				"          entradas,",
				"          salidas,",
				"          stock_final,",
				"          stock_minimo",
				"     )) ~> sink1"
			]
		}
	}
}